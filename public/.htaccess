# مسدودسازی دسترسی به فایل‌های حساس، پیکربندی و سورس
<FilesMatch "^\.(?!well-known)|\.(sql|md|env|sample\.php|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # انتقال هدر Authorization به PHP در هاست‌های آپاچی cPanel
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

  # اگر درخواست به مسیر api ارسال شده، به api/index.php هدایت شود
  RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
  RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

  # جلوگیری از بازنویسی فایل‌های استاتیک و فونت‌های گمشده به index.html
  RewriteCond %{REQUEST_URI} \.(ttf|woff|woff2|eot|otf|svg|png|jpg|jpeg|gif|ico|webp)$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]

  # مسیرهای React SPA: فایل‌ها و پوشه‌های واقعی مستقیماً سرو شوند
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# تنظیم هدرهای امنیتی و کدگذاری UTF-8
AddDefaultCharset UTF-8
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
