# ---- دیتابیس MySQL (ساخته‌شده در cPanel > MySQL Databases) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpaneluser_regdb
DB_PASS=STRONG_DB_PASSWORD
DB_NAME=cpaneluser_registration

# ---- احراز هویت ----
# یک رشته تصادفی بلند بسازید:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_HEX_96

# ---- ووکامرس (فقط سمت سرور — هرگز به فرانت‌اند نمی‌رود؛ CR-4) ----
WOO_STORE_URL=https://your-shop.example.com
WOO_CONSUMER_KEY=ck_xxxxxxxx
WOO_CONSUMER_SECRET=cs_xxxxxxxx

# ---- سایر ----
PORT=3777
# اگر فرانت از دامنه/پروتکل متفاوتی API را صدا می‌زند (معمولاً نه؛ چون Node.js App همان دامنه را سرو می‌کند):
# CORS_ORIGIN=https://reg.yourdomain.com
