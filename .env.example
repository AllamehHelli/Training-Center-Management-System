# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_ENABLE_DEMO_TOOLS: HI-1 safety gate for destructive demo actions such
# as "RESET_DATA" (بازنشانی داده‌ها). The reset button is hidden in production
# builds unless this flag is explicitly set to "true". Never enable it on
# operational deployments holding real records.
VITE_ENABLE_DEMO_TOOLS="false"


# VITE_DEMO_TODAY: HI-6 demo/testing gate for "today". When set to a valid
# Jalali date (YYYY/MM/DD), getTodayJalali() returns it instead of converting
# the real system clock — useful for demos with fixed sample data. Leave empty
# or remove in operational deployments so overdue/due-date calculations always
# follow the real current date. Invalid values are ignored with a console warning.
VITE_DEMO_TODAY=""

# VITE_WOO_PROXY_BASE: HI-5 — base URL of a server-side proxy for WooCommerce
# REST calls (e.g. https://backend.example.com/api/woo-proxy). The browser
# sends requests to <proxy>?url=<encoded woo endpoint>; the proxy attaches the
# consumer key/secret server-side and forwards them, avoiding CORS errors and
# keeping credentials out of the frontend bundle. Leave empty only for local
# development against a store that explicitly allows CORS.
VITE_WOO_PROXY_BASE=""

# CR-4 (security): WooCommerce consumer keys entered in the Woo page are held
# in memory for the current browser session ONLY — they are stripped before
# anything is written to localStorage or exported backups. Do NOT add real
# keys to this .env file; Vite inlines every VITE_* variable into the public
# JS bundle. Server-side keys belong in your backend's environment/secret
# manager, not here. See docs/SECURITY.md.
